# -----------------------------------------------------------------------------
# Environment variables for smolikja.team.
#
# Copy this file to `.env.local` and fill in the values for local development:
#
#     cp .env.example .env.local
#
# `.env.local` is git-ignored — never commit real values. Production values are
# configured in Coolify, not here. Next.js loads these automatically.
# -----------------------------------------------------------------------------

# SMTP login of the mailbox the contact-form Server Action sends from; it is
# also the From address. Server-only (no NEXT_PUBLIC_ prefix). See
# docs/contact-form.md.
#
# REQUIRED for the contact form. Without them the form renders, but every
# submission returns the generic error state and nothing is sent.
SMTP_USER=hey@smolikja.team
SMTP_PASSWORD=

# Recipient of contact-form e-mails. RECOMMENDED — defaults to
# `siteConfig.email` in src/config/site.ts. Use an inbox other than SMTP_USER:
# some mail clients ignore Reply-To on mail from one's own address.
CONTACT_TO_EMAIL=jakub@smolikja.team

# Mail server. OPTIONAL — default to Purelymail with implicit TLS on 465; use
# 587 (STARTTLS) if the host blocks outgoing 465.
# SMTP_HOST=smtp.purelymail.com
# SMTP_PORT=465
