# -----------------------------------------------------------------------------
# Environment variables for smolikja.team.
#
# Copy this file to `.env.local` and fill in the values for local development:
#
#     cp .env.example .env.local
#
# `.env.local` is git-ignored — never commit real values. Production values are
# configured in Coolify, not here. Next.js loads these automatically.
# -----------------------------------------------------------------------------

# Resend API key used by the contact-form Server Action to deliver messages.
# Server-only (no NEXT_PUBLIC_ prefix). See docs/contact-form.md.
#
# REQUIRED for the contact form. Without it the form renders, but every
# submission returns the generic error state and nothing is sent.
RESEND_API_KEY=

# Sender address for contact-form e-mails. Must belong to a domain verified in
# Resend (e.g. web@smolikja.team). REQUIRED together with RESEND_API_KEY.
CONTACT_FROM_EMAIL=web@smolikja.team

# Recipient of contact-form e-mails. OPTIONAL — defaults to `siteConfig.email`
# in src/config/site.ts.
# CONTACT_TO_EMAIL=
